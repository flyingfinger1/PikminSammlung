# Copy to .env next to docker-compose.yml on the server and fill in.
# Secret for uploads from tools/publish.py (same value as "token" in publish.local.json), >= 24 chars
UPLOAD_TOKEN=change-me-to-a-long-random-string

# Optional: require a login for viewing. Leave both out for a public page.
#VIEW_USER=pikmin
#VIEW_PASSWORD=change-me
